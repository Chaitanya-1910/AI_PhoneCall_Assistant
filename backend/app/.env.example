# =============================================================================
# CHAYA Environment Configuration
# Copy this file to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=CHAYA
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chaya:changeme@localhost:5432/chaya
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Groq (LLM)
# -----------------------------------------------------------------------------
GROQ_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30.0
GROQ_RETRY_COUNT=3

# -----------------------------------------------------------------------------
# Faster-Whisper (Speech-to-Text)
# -----------------------------------------------------------------------------
WHISPER_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TIMEOUT=30.0
WHISPER_RETRY_COUNT=3

# -----------------------------------------------------------------------------
# ElevenLabs (Text-to-Speech)
# -----------------------------------------------------------------------------
ELEVENLABS_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_TIMEOUT=30.0
ELEVENLABS_RETRY_COUNT=3

# -----------------------------------------------------------------------------
# Storage Settings
# -----------------------------------------------------------------------------
MAX_AUDIO_UPLOAD_SIZE_MB=10
AUDIO_EXPIRATION_SECONDS=3600

# -----------------------------------------------------------------------------
# Conversation Intelligence Settings
# -----------------------------------------------------------------------------
CONV_MAX_HISTORY_TURNS=10
CONV_MAX_PROMPT_SIZE_TOKENS=8000
CONV_MAX_SUMMARY_SIZE_TOKENS=1000
CONV_FALLBACK_RESPONSE="I'm sorry, but I'm having trouble understanding right now. Could we try again?"
CONV_INTENT_CONFIDENCE_THRESHOLD=0.7
CONV_MAX_RESPONSE_LENGTH=1000

# -----------------------------------------------------------------------------
# CORS (comma-separated origins for Android / web clients)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:8000
